{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
    },
  },
  "plugin": [
    "dude@git+https://github.com/yowcow/dude.git",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
  ],
  "mcp": {
    "fluct-mysql": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bytebase/dbhub",
        "--transport",
        "stdio",
        "--config",
        "~/.config/dbhub/dbhub.toml",
      ],
      "enabled": true,
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "{cwd}",
      ],
      "environment": {
        "PYTHONUNBUFFERED": "1",
      },
    },
  },
}
