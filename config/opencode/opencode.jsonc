{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 51200,
  },
  "agents": {
    "general": { "steps": 100 },
    "explore": { "steps": 100 },
  },
  "experimental": {
    "background_compaction": true,
  },
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
    },
  },
  "plugin": [
    "dude@git+https://github.com/yowcow/dude.git",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
  ],
  "mcp": {
    "fluct-mysql": {
      "type": "local",
      "command": [
        "dbhub",
        "--transport",
        "stdio",
        "--config",
        "~/.config/dbhub/dbhub.toml",
      ],
      "enabled": true,
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "{cwd}",
      ],
      "environment": {
        "PYTHONUNBUFFERED": "1",
      },
    },
  },
}
