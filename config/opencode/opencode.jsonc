{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "git push *": "ask",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
    },
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
  ],
  "mcp": {
    "fluct-mysql": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bytebase/dbhub",
        "--transport",
        "stdio",
        "--config",
        "~/.config/dbhub/dbhub.toml",
      ],
      "enabled": true,
    },
  },
}
