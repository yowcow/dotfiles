#!/bin/sh

HELP=false
VERBOSE=false

while [ $# -gt 0 ]; do
    case "$1" in
        -[vh]* )
            stacked=${1#-}
            case "$stacked" in *[!vh]*) echo "vacuum: unknown option: $1" >&2; exit 2;; esac
            case "$stacked" in *v*) VERBOSE=true;; esac
            case "$stacked" in *h*) HELP=true;; esac
            shift ;;
        --verbose ) VERBOSE=true; shift ;;
        --help ) HELP=true; shift ;;
        -- ) shift; break ;;
        --* | -* ) echo "vacuum: unknown option: $1" >&2; exit 2 ;;
        * ) break ;;
    esac
done

if [ "$HELP" = true ]; then
    echo "Usage: $0 [-v|--verbose] [-h|--help] [--] <command>"
    echo
    echo "Options:"
    echo "  -v, --verbose   Show stderr instead of discarding it"
    echo "  -h, --help      Show this help message and exit"
    echo
    echo "Commands:"
    echo "  <command>       A command to run while dumping stderr to /dev/null"
    exit 0
fi

if [ $# -eq 0 ]; then
    echo "vacuum: no command specified" >&2
    echo "Usage: $0 [-v|--verbose] [-h|--help] [--] <command>" >&2
    exit 2
fi

if ! command -v "$1" >/dev/null 2>&1; then
    echo "vacuum: $1: command not found" >&2
    exit 127
fi

if [ "$VERBOSE" = true ]; then
    exec "$@"
else
    exec "$@" 2>/dev/null
fi
